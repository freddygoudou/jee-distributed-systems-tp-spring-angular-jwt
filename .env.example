# Copiez ce fichier en .env et renseignez vos valeurs.
# .env est gitignoré : ne committez jamais vos secrets.
# Utilisé par docker-compose (variables passées au conteneur backend).

# Clé OpenAI pour le chatbot RAG (laisser vide désactive les réponses IA)
OPENAI_API_KEY=

# Bot Telegram (optionnel). Mettre TELEGRAM_ENABLED=true pour l'activer.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
